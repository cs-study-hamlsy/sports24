# 운동24 환경변수 예시. 실제 값은 .env.local에 넣고 커밋하지 않는다.

# AI 정책 분석(/api/analyze). 없으면 계산 엔진 결과로 대체된다.
OPENAI_API_KEY=
# 선택. 지정하지 않으면 gpt-4o-mini 사용.
OPENAI_MODEL=gpt-4o-mini

# 스포츠강좌이용권 등록강좌 조회(/api/courses). data.go.kr 인증키.
SPORTS_COURSE_API_KEY=

# 국민체육진흥공단 전국체육시설 정보 조회(/api/facilities). data.go.kr 인증키.
SPORTS_FACILITY_API_KEY=

# 행정안전부 지역별 성별·연령별 주민등록 인구(odcloud). data.go.kr 인증키.
# scripts/build-real-data.mjs가 이 키로 실측 인구·시설 데이터를 정제한다.
POPULATION_API_KEY=
